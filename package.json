    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "prisma:generate": "prisma generate --generator client",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:database": "tsx scripts/validate-database.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "import:collection:evidence": "tsx scripts/import-collection-evidence.ts",
    "reconcile:search": "tsx scripts/reconcile-search-index.ts",
    "link:editorial-principal": "tsx scripts/link-editorial-principal.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.20.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
