DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_OIDC_ISSUER="https://issuer.example.com"
AUTH_OIDC_CLIENT_ID="sentinel-oidc"
AUTH_OIDC_CLIENT_SECRET="replace-in-local-secret-store"
EDITOR_SUBJECTS='[{"issuer":"https://issuer.example.com","subject":"provider-subject"}]'
# Provisioning descriptor for the seeded owner principal. Runtime authorization reads the
# EditorialPrincipal database row; keep this descriptor in deployment notes/secrets and
# replace the null subject only after the OIDC provider returns the immutable subject.
EDITOR_PRINCIPALS='[{"displayName":"Puneeth Kakarla","email":"puneethkakarla@gmail.com","issuer":"https://issuer.example.com","subject":null,"roles":["REVIEWER","PUBLISHER"],"active":false}]'
SITE_URL="http://localhost:3000"
