generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================
// CORE CONTENT MODELS
// ============================

model Conflict {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  shortTitle     String?
  summary        String
  content        String?
  dateStart      String
  dateEnd        String?
  theatres       String   // JSON string array
  coordinates    String?  // JSON string: [lat, lng]
  referenceUrl   String?
  outcomeSummary String?
  contextSummary String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operations Operation[]
  people     Person[]
  equipment  Equipment[]
}

model Person {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  fullName      String
  summary       String
  content       String?
  rank          String?
  birthDate     String?
  deathDate     String?
  serviceBranch String?
  decorations   String?
  conflict      String?
  year          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conflicts  Conflict[]
  operations Operation[]
}

model Operation {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  category     String
  summary      String
  content      String?
  dateStart    String
  dateEnd      String?
  coordinates  String?  // JSON string: [lat, lng]
  referenceUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conflicts Conflict[]
  people    Person[]
}

model Equipment {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  domain          String
  category        String
  summary         String
  content         String?
  developmentModel String
  serviceStatus   String
  inductedYear    Int?
  retiredYear     Int?
  originCountries String   // JSON string array
  specs           String   // JSON string
  variantLabel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conflicts Conflict[]
}

model Unit {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  summary         String   @default("")
  content         String?
  serviceId       String?
  unitType        String
  parentUnitId    String?
  motto           String?
  warCry          String?
  establishedDate String?
  disbandedDate   String?
  ranksJson       String?
  awardsJson      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Unit?  @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  children Unit[] @relation("UnitHierarchy")

  @@index([serviceId, unitType])
}

model Source {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  summary         String   @default("")
  author          String?
  publicationDate String?
  publisher       String?
  canonicalUrl    String?
  sourceType      String?
  tier            String?
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
